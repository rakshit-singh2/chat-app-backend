# ==========================================================================
# Chat app backend - environment template
#
# Copy to the file for your environment and fill in the values:
#   .env.development   (npm run dev)
#   .env.staging       (npm run start:staging)
#   .env.production    (npm start)
# Use separate databases, secrets, origins and buckets for each environment.
# Never commit the real files - they contain secrets.
# ==========================================================================

# --- Server ---------------------------------------------------------------
PORT=8000
# Web app origins allowed to call the API and Socket.IO (comma-separated,
# exact scheme + host + port, no trailing slash). Required outside development.
CORS_ORIGINS=http://localhost:5173
# Number of proxies in front of the API (e.g. 1 behind Nginx or a load
# balancer). Leave empty when running locally.
TRUST_PROXY=

# --- Redis (optional) -------------------------------------------------------
# Needed when running more than one API instance: shares Socket.IO events,
# presence and rate limits between them. Leave empty for a single instance.
# Example: redis://localhost:6379  or  rediss://user:password@host:6380
REDIS_URL=
# Prefix for this app's keys (useful if the Redis server is shared).
REDIS_KEY_PREFIX=chat-app:

# --- Database (MongoDB) ---------------------------------------------------
# URL-encode special characters in the password (@ -> %40, : -> %3A).
# Use a dedicated database for this app and environment.
DATABASE=mongodb+srv://<db_user>:<url_encoded_password>@<cluster-host>/chatapp_development

# --- Authentication -------------------------------------------------------
# Signs short-lived access tokens. At least 32 random characters, different
# per environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=<generate-a-48-byte-random-secret>
# Token lifetimes: seconds, or a number with s/m/h/d (e.g. 15m, 30d).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Optional token claims (defaults: chat-app-api / chat-app-clients).
JWT_ISSUER=
JWT_AUDIENCE=
# Maximum signed-in devices per user; older sessions are signed out.
MAX_SESSIONS_PER_USER=10
# bcrypt cost for password hashing (12 is a good default; higher is slower).
BCRYPT_ROUNDS=12

# --- Refresh-token cookie (web app) ---------------------------------------
# strict | lax | none. Use none only when the web app and API are on
# different sites (e.g. app.com and api.other.com); it requires SECURE=true.
REFRESH_COOKIE_SAMESITE=strict
# true | false. Empty = true everywhere except development.
REFRESH_COOKIE_SECURE=
# Optional, e.g. .example.com to share the cookie across subdomains.
REFRESH_COOKIE_DOMAIN=
# Optional cookie name (default: refresh_token).
REFRESH_COOKIE_NAME=

# --- Password reset links -------------------------------------------------
# Web page that handles reset tokens. Empty = <first CORS origin>/auth/new-password
PASSWORD_RESET_URL=
# Deep link used for requests from the mobile app, e.g. chatapp://reset-password
MOBILE_PASSWORD_RESET_URL=

# --- Email ----------------------------------------------------------------
# NODEMAILER (any SMTP server) or SENDGRID. Only the selected provider's
# settings are required; startup fails if they are missing.
MAIL_PROVIDER=NODEMAILER
# Sender address, verified with your provider.
MAIL_FROM=chat.app@example.com
# SMTP (MAIL_PROVIDER=NODEMAILER). For Gmail: smtp.gmail.com, 465, true and a
# Google App Password (not your account password) in SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# SendGrid API key starting with SG. (MAIL_PROVIDER=SENDGRID)
SG_KEY=

# --- File storage (AWS S3) ------------------------------------------------
# Private bucket for chat attachments and avatars, e.g. ap-south-1.
AWS_REGION=
S3_BUCKET_NAME=
# Local development: an IAM user allowed only s3:PutObject and s3:GetObject on
# this bucket. Production: leave empty and use the server's IAM role.
# The bucket also needs CORS for each web origin - see README "File attachments".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Push notifications (Web Push) ------------------------------------------
# VAPID keys identify this server to browser push services. Generate a pair per
# environment with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a contact URL or mailto: for the push service operator.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Audio / video calls --------------------------------------------------
# AGORA (hosted) or MEDIASOUP (self-hosted SFU in this process).
STREAMING_SERVICE=AGORA

# Agora: 32-character App ID and App Certificate from the Agora console.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# mediasoup: listen on all interfaces; announce the host's public IP and open
# the UDP/TCP port range in the firewall.
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
# JSON array of STUN/TURN servers, e.g.
# [{"urls":"turn:turn.example.com:3478","username":"chat","credential":"secret"}]
CALL_ICE_SERVERS=[]
